# API base URL used by the Next.js server (server components). Can be an internal address.
API_URL=http://127.0.0.1:4100/api

# API base URL used by the browser (booking form). Inlined at build time.
NEXT_PUBLIC_API_URL=http://localhost:4100/api

# Public URL of this site (used for absolute Open Graph URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3100
