# Copy to .env and adjust. Never commit real credentials.

NODE_ENV=development
HOST=127.0.0.1
PORT=4100

# PostgreSQL connection string. `npm run db:start` (repo root) starts a
# project-local PostgreSQL on port 5433 that matches this value.
DATABASE_URL=postgres://reservation:reservation@127.0.0.1:5433/reservation

# Optional: database for the e2e tests, which wipe it on every run. Its name must
# end in _test. Defaults to DATABASE_URL with _test added to the database name.
# TEST_DATABASE_URL=postgres://reservation:reservation@127.0.0.1:5433/reservation_test

# Apply pending migrations automatically on boot.
DB_RUN_MIGRATIONS=true

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# IANA time zone of the hotel. Decides what "today" means for check-in dates.
HOTEL_TIMEZONE=UTC

# Set to true when running behind a reverse proxy (rate limiting uses the client IP).
TRUST_PROXY=false
